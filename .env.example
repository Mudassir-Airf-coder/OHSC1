# ============================================================
# OHSC + Graphify Brain — example environment configuration
# COPY to ".env" and fill in REAL secrets locally. NEVER commit ".env".
# This file contains PLACEHOLDERS ONLY.
# ============================================================

# --- Graphify Brain backend selection ---
# Production backend. Use OpenCode as the LLM execution layer.
GRAPHIFY_BRAIN_BACKEND=opencode
# Model identifier inside OpenCode (HY3).
GRAPHIFY_BRAIN_MODEL=opencode/hy3-free

# --- OpenCode credential (SECRET) ---
# The OpenCode API key is read from the environment by the OpenCode CLI.
# OHSC / Graphify Brain NEVER hard-code, print, or log this value.
OPENCODE_API_KEY=

# Optional overrides (leave blank to use defaults):
# GRAPHIFY_BRAIN_TIMEOUT=120
# GRAPHIFY_BRAIN_LOG_LEVEL=INFO