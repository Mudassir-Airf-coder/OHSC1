# ============================================================
# OHSC + Graphify Brain — example environment configuration
# COPY to ".env" and fill in REAL secrets locally. NEVER commit ".env".
# This file contains PLACEHOLDERS ONLY.
# ============================================================

# --- Graphify Brain backend selection ---
# Recommended for most users: groq (OpenAI-compatible, no local gateway required)
GRAPHIFY_BRAIN_BACKEND=groq
GRAPHIFY_BRAIN_MODEL=openai/gpt-oss-120b

# Groq API key (SECRET) — required when GRAPHIFY_BRAIN_BACKEND=groq
# Get one at https://console.groq.com/
GROQ_API_KEY=

# --- Alternative: OpenCode backend ---
# GRAPHIFY_BRAIN_BACKEND=opencode
# GRAPHIFY_BRAIN_MODEL=opencode/hy3-free
# OPENCODE_API_KEY=

# Optional overrides:
# GRAPHIFY_BRAIN_ENDPOINT=https://api.groq.com/openai/v1
# GRAPHIFY_BRAIN_TIMEOUT=120
# GRAPHIFY_BRAIN_LOG_LEVEL=INFO

# OHSC roots (optional — also set via shell env)
# OHSC_SYSTEM_ROOT=
# OHSC_VAULT_ROOT=
